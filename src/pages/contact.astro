---
import ContentLayout from "../layouts/ContentLayout.astro";
---

<ContentLayout
	title="Contact Us"
	description="Contact Glass Graphics for custom engraved promotional products and awards. Located in Conway, NH."
>
	<div class="grid-2">
		<div class="card">
			<h2>Mailing & Physical Address</h2>
			<address>
				<strong>Glass Graphics</strong><br />
				Decorated Promotional Products & Awards<br />
				56 Pleasant St<br />
				Conway, NH 03818
			</address>

			<div class="contact-details">
				<div class="contact-item">
					<span class="label">Phone</span>
					<a href="tel:+16034471900">(603) 447-1900</a>
				</div>

				<div class="contact-item">
					<span class="label">Email</span>
					<a href="mailto:info@glassgraphics.com"
						>info@glassgraphics.com</a
					>
				</div>
			</div>
		</div>

		<div class="card">
			<h2>Find Us</h2>
			<div class="map-container">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2891.8!2d-71.1283!3d43.9792!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cb39a0c0c0c0c0c%3A0x0!2s56%20Pleasant%20St%2C%20Conway%2C%20NH%2003818!5e0!3m2!1sen!2sus!4v1234567890"
					width="100%"
					height="250"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					title="Glass Graphics Location"></iframe>
			</div>
		</div>
	</div>
</ContentLayout>

<style>
	address {
		font-style: normal;
		line-height: 1.8;
		margin-bottom: 1.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.1);
	}

	address strong {
		font-size: 1.05rem;
		color: var(--gg-text);
	}

	.contact-details {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contact-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.contact-item .label {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--gg-muted);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.contact-item a {
		font-size: 1.05rem;
	}

	.map-container {
		border-radius: 0.5rem;
		overflow: hidden;
	}

	.map-container iframe {
		display: block;
	}
</style>
